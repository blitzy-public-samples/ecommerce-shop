{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      // Flash-Sale feature (review finding F09): the ALL-ENVIRONMENT enforcement of this threshold lives
      // PROGRAMMATICALLY in Program.cs (.ConfigureLogging AddFilter Microsoft.AspNetCore.Hosting = Warning),
      // because the repository .gitignores the base appsettings.json so a config-file default would not commit.
      // This Development entry is kept at the SAME Warning level (never less restrictive) to keep configuration
      // self-documenting; the programmatic filter is the authoritative guarantee that the query-string
      // access_token is not written to request-URL logs in ANY environment (§0.6).
      "Microsoft.AspNetCore.Hosting": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost; Port=5432;User Id=appuser; Password=secret; Database=e-commerce",
    "IdentityConnection": "Server=localhost; Port=5432;User Id=appuser; Password=secret; Database=identity",
     "Redis": "localhost"
  },
  "Token": {
    // Review finding M24: the patched Microsoft.IdentityModel.Tokens (6.35.0) enforces the RFC 2104 / FIPS
    // rule that an HMAC-SHA512 signing key must be at least 512 bits. The prior "super secret key" was only
    // 128 bits and caused IDX10720 at token issuance. This key is 552 bits (69 UTF-8 bytes) and is a DEV
    // placeholder only — override Token:Key via environment/secrets in real deployments.
    "Key": "blitzy-flash-sale-development-jwt-signing-key-hmac-sha512-change-me!!",
    "Issuer": "https://localhost:5001"
  },
  "ApiUrl": "https://localhost:5001/Content/",
  // Flash-Sale feature (review finding F07): real-time inventory + reservation configuration. The hub path is
  // ALSO resolved in code: IdentityServiceExtensions falls back to the canonical InventoryHub.HubPath constant
  // when SIGNALR_HUB_PATH is absent/blank, and the future endpoints.MapHub<InventoryHub> will reuse that same
  // constant — so query-token extraction can never silently no-op in any environment even without this key. This
  // Development value simply pins the same path explicitly (environment-overridable per AAP §0.3.1).
  "SIGNALR_HUB_PATH": "/hubs/inventory",
  "RESERVATION_TTL_SECONDS": 300,
  "FLASH_SALE_POLL_INTERVAL_MS": 5000
}
