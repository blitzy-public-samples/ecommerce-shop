<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="8.1.1" />
    <!-- Flash-Sale feature (review finding M23): JwtBearer 5.0.8 -> 5.0.17 patches GHSA-q7cg-43mg-qp69
         (unparseable tokens could be logged before application log filtering). The hub introduces query-string
         token ingress, so the affected 5.0.8 build is upgraded to the patched, runtime-aligned 5.0.17. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="5.0.17" />
    <!-- Flash-Sale feature (review finding M18): the previously-added Microsoft.AspNetCore.Authentication
         .OpenIdConnect reference was UNUSED anywhere in code and is removed to honour the frozen minimal .NET
         package footprint (AAP §0.3.1). The JwtBearer scheme above is the only authentication package the app
         actually consumes (IdentityServiceExtensions.AddJwtBearer). -->
    <!-- Flash-Sale feature (review finding M24): pin the IdentityModel/JWT stack to patched 6.35.0
         (GHSA-59j7-ghrg-fj52: oversized compressed tokens -> excessive CPU/memory). These DIRECT references
         override the vulnerable 6.12.0 pulled transitively by the auth packages above; query-string hub auth is
         another untrusted token ingress, so the DoS-hardened token parser is required. -->
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="6.35.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.35.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="5.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="5.6.3" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Content\**" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot" />
  </ItemGroup>

</Project>
